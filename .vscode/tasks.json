{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: install npm packages",
      "type": "shell",
      "command": "npm ci",
      "problemMatcher": []
    },
    {
      "label": "setup: create pipeline venv",
      "type": "shell",
      "command": "python3 -m venv pipeline/.venv",
      "windows": {"command": "python -m venv pipeline\\.venv"},
      "problemMatcher": []
    },
    {
      "label": "setup: install pipeline requirements",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/pipeline"},
      "command": ".venv/bin/python -m pip install -r requirements-dev.txt",
      "windows": {"command": ".venv\\Scripts\\python -m pip install -r requirements-dev.txt"},
      "problemMatcher": []
    },
    {
      "label": "setup: check pipeline/.env",
      "detail": "Creates pipeline/.env from .env.example, then stops until GROQ_API_KEY is filled in",
      "type": "shell",
      "command": "node -e \"const fs=require('fs');const p='pipeline/.env';if(!fs.existsSync(p)){fs.copyFileSync('pipeline/.env.example',p);console.log('Created '+p+' from pipeline/.env.example')}if(!/^GROQ_API_KEY=\\S+/m.test(fs.readFileSync(p,'utf8'))){console.error('GROQ_API_KEY is empty: paste your key (https://console.groq.com/keys) into pipeline/.env, then run Setup (fresh clone) again.');process.exit(1)}console.log('pipeline/.env OK')\"",
      "problemMatcher": []
    },
    {
      "label": "setup: fetch, classify and build data",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/pipeline", "env": {"PYTHONIOENCODING": "utf-8"}},
      "command": ".venv/bin/python -m radar all",
      "windows": {"command": ".venv\\Scripts\\python -m radar all"},
      "problemMatcher": []
    },
    {
      "label": "Setup (fresh clone)",
      "detail": "npm ci, pipeline venv + requirements, pipeline/.env check, python -m radar all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "setup: install npm packages",
        "setup: create pipeline venv",
        "setup: install pipeline requirements",
        "setup: check pipeline/.env",
        "setup: fetch, classify and build data"
      ],
      "problemMatcher": []
    },
    {
      "label": "Dev",
      "detail": "Same as App: start dev server",
      "dependsOn": ["App: start dev server"],
      "problemMatcher": []
    },
    {
      "label": "App: start dev server",
      "detail": "Vite on http://localhost:5173, reads public/data/*.json",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {"regexp": "^x^"},
        "background": {"activesBegin": "VITE", "beginsPattern": "VITE", "endsPattern": "Local:"}
      },
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "App: test",
      "type": "npm",
      "script": "test",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "App: production build",
      "type": "npm",
      "script": "build",
      "problemMatcher": []
    },
    {
      "label": "App: production build + preview",
      "detail": "Builds to build/ and serves it (no && so it also runs in Windows PowerShell 5.1)",
      "type": "npm",
      "script": "preview",
      "dependsOn": ["App: production build"],
      "problemMatcher": []
    },
    {
      "label": "Pipeline: set up Python environment",
      "detail": "Creates pipeline/.venv and installs requirements (run once)",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/pipeline"},
      "windows": {"command": "python -m venv .venv; .venv/Scripts/pip install -r requirements-dev.txt"},
      "linux": {"command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt"},
      "osx": {"command": "python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt"},
      "problemMatcher": []
    },
    {
      "label": "Pipeline: update data",
      "detail": "Fetch from Pagella Politica, classify new verdicts with Groq (pipeline/.env), rebuild public/data",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/pipeline", "env": {"PYTHONIOENCODING": "utf-8"}},
      "windows": {"command": ".venv/Scripts/python -m radar all"},
      "linux": {"command": ".venv/bin/python -m radar all"},
      "osx": {"command": ".venv/bin/python -m radar all"},
      "problemMatcher": []
    },
    {
      "label": "Pipeline: rebuild data from cache (offline)",
      "detail": "Re-export public/data from the last download and the saved labels; no network",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/pipeline", "env": {"PYTHONIOENCODING": "utf-8"}},
      "windows": {"command": ".venv/Scripts/python -m radar build"},
      "linux": {"command": ".venv/bin/python -m radar build"},
      "osx": {"command": ".venv/bin/python -m radar build"},
      "problemMatcher": []
    },
    {
      "label": "Pipeline: measure label agreement",
      "detail": "Re-rates a sample with Groq and publishes the agreement on /metodo",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/pipeline", "env": {"PYTHONIOENCODING": "utf-8"}},
      "windows": {"command": ".venv/Scripts/python -m radar evaluate"},
      "linux": {"command": ".venv/bin/python -m radar evaluate"},
      "osx": {"command": ".venv/bin/python -m radar evaluate"},
      "problemMatcher": []
    },
    {
      "label": "Pipeline: test",
      "type": "shell",
      "options": {"cwd": "${workspaceFolder}/pipeline"},
      "windows": {"command": ".venv/Scripts/python -m pytest -q"},
      "linux": {"command": ".venv/bin/python -m pytest -q"},
      "osx": {"command": ".venv/bin/python -m pytest -q"},
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Test everything",
      "dependsOn": ["App: test", "Pipeline: test"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {"kind": "test", "isDefault": true}
    }
  ]
}

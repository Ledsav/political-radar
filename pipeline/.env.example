# Copy to .env and fill in. .env is gitignored.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model
# GROQ_MODEL=openai/gpt-oss-120b
# Optional: rate with Claude instead when GROQ_API_KEY is empty (also: pip install anthropic)
# ANTHROPIC_API_KEY=
# Optional: only for scripts/probe_google_factcheck.py (exploring other fact-checkers)
# Google Cloud console -> enable "Fact Check Tools API" -> Credentials -> API key
# GOOGLE_FACTCHECK_API_KEY=
